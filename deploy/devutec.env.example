# Copia de referencia de /etc/devutec.env (en el servidor, con chmod 600).
# Los valores reales NO se suben al repositorio.
DB_URL=jdbc:postgresql://<endpoint-rds>:5432/devutec
DB_USERNAME=devutec
DB_PASSWORD=<contrasena-rds>
JWT_SECRET=<generado con: openssl rand -hex 32>
MAIL_USERNAME=<usuario-mailtrap>
MAIL_PASSWORD=<contrasena-mailtrap>
CORS_ALLOWED_ORIGINS=https://<app>.vercel.app,http://localhost:5173
