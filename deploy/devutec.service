[Unit]
Description=Devutec backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/devutec-backend
EnvironmentFile=/etc/devutec.env
ExecStart=/usr/bin/java -jar /home/ec2-user/devutec-backend/target/devutec-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
