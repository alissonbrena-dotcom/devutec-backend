#!/bin/bash
set -euo pipefail
cd /home/ec2-user/devutec-backend

git fetch -q origin main
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/main)

if [ "$LOCAL" = "$REMOTE" ]; then
  echo "Sin cambios en main ($(git log -1 --format=%h))"
  exit 0
fi

BACKEND_CHANGES=$(git diff --name-only "$LOCAL" "$REMOTE" -- src pom.xml mvnw .mvn)

if [ -z "$BACKEND_CHANGES" ]; then
  git merge -q --ff-only origin/main
  echo "Cambios sin tocar el backend ($(git log -1 --format='%h %s')). Codigo actualizado; la API no se reinicia."
  exit 0
fi

echo "Cambios en el backend ($(git log -1 --format='%h %s' origin/main)). Desplegando..."
exec /usr/local/bin/devutec-redeploy
