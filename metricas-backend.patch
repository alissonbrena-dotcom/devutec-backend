+++ b/src/main/java/pe/edu/utec/devutec/metrics/MetricsResponseDTO.java
@@ -0,0 +1,59 @@
+package pe.edu.utec.devutec.metrics;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
